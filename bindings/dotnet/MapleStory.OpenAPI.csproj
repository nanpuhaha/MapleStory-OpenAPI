<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 does not support native LPUTF8Str unmanaged marshalling or direct Exe output; modern .NET 8 LTS and .NET 9 STS are targeted -->
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <RootNamespace>MapleStory.OpenAPI</RootNamespace>
    <AssemblyName>MapleStory.OpenAPI</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PackageId>MapleStory.OpenAPI</PackageId>
    <Version>0.1.0</Version>
    <Authors>Senior Engineer</Authors>
    <Description>High-performance .NET bindings for NEXON MapleStory OpenAPI, powered by Rust</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Copy native Rust DLL to output directory on Windows -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="..\..\target\release\maplestory_openapi_c.dll" Link="maplestory_openapi_c.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
